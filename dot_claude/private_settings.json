{
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Edit(.ssh/*)"
    ],
    "ask": [
      "Bash(npm i:*)",
      "Bash(npm install:*)",
      "Bash(pnpm i:*)",
      "Bash(pnpm install:*)",
      "Bash(gh api * --method POST *)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-sonnet-5",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "open -g 'raycast://confetti?emojis=🔔'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '~/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "open -g 'raycast://confetti?emojis=✅'"
          }
        ]
      }
    ]
  },
  "language": "Japanese",
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "tui": "default",
  "theme": "auto",
  "editorMode": "normal",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "useAutoModeDuringPlan": true
}
