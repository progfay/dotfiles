{
  "agentPushNotifEnabled": true,
  "awaySummaryEnabled": false,
  "editorMode": "normal",
  "effortLevel": "high",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "open -g 'raycast://confetti?emojis=🔔'",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|idle_prompt"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "open -g 'raycast://confetti?emojis=✅'",
            "type": "command"
          }
        ]
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "language": "Japanese",
  "model": "claude-sonnet-5",
  "permissions": {
    "ask": [
      "Bash(npm i *)",
      "Bash(npm install *)",
      "Bash(pnpm i *)",
      "Bash(pnpm install *)",
      "Bash(gh api * --method POST *)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Edit(.ssh/*)"
    ]
  },
  "theme": "auto",
  "tui": "default",
  "useAutoModeDuringPlan": true
}
