{
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "PONYTAIL_DEFAULT_MODE": "full"
  },
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(npx *)",
      "Bash(pnpm dlx *)",
      "Edit(.ssh/*)"
    ],
    "ask": [
      "Bash(npm i *)",
      "Bash(npm install *)",
      "Bash(pnpm i *)",
      "Bash(pnpm install *)",
      "Bash(gh api * --method POST *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/notifire 🔔",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/notifire ✅",
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail",
        "ref": "v4.9.0"
      }
    }
  },
  "advisorModel": "opus",
  "outputStyle": "Concise",
  "language": "Japanese",
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "tui": "default",
  "theme": "auto",
  "editorMode": "normal",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "useAutoModeDuringPlan": true
}
