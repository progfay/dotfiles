    "version": "0.1.0",
    "min_herdr_version": "0.7.0",
    "description": "現在のtab内の全paneのsplit木構造を維持したまま、各splitのratioを均等値に再計算して見やすく整列させる",
    "manifest_path": "/Users/progfay/.config/herdr/plugins/equalize-panes/herdr-plugin.toml",
    "plugin_root": "/Users/progfay/.config/herdr/plugins/equalize-panes",
    "enabled": true,
    "platforms": [
      "macos"
    ],
    "actions": [
      {
        "id": "equalize",
        "title": "Equalize panes in current tab",
        "contexts": [
          "tab"
        ],
        "command": [
          "bash",
          "equalize.sh"
        ]
      }
    ],
    "source": {
      "kind": "local"
    }
  },
